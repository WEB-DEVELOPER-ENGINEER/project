# JUSOR Translation Services - Environment Variables Template
# Copy this file to .env.local for development or .env.production for production
# DO NOT commit actual secrets to version control

# ==============================================
# SITE CONFIGURATION
# ==============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=JUSOR Translation Services
NEXT_PUBLIC_COMPANY_DESCRIPTION=Professional translation services for legal, technical, and business documents
NEXT_PUBLIC_COMPANY_PHONE=+971503244329
NEXT_PUBLIC_COMPANY_EMAIL=info@jusortrans.com
NEXT_PUBLIC_COMPANY_ADDRESS=Dubai, UAE

# ==============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jusor_nextjs
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# For production, consider using connection strings:
# DATABASE_URL=postgresql://user:password@host:port/database

# ==============================================
# SECURITY & AUTHENTICATION
# ==============================================
# Generate a secure secret key with: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-here-minimum-32-characters-required
NEXTAUTH_URL=http://localhost:3000

# Content Security Policy nonce (optional)
NEXT_PUBLIC_CSP_NONCE=your-csp-nonce

# ==============================================
# EMAIL CONFIGURATION (SMTP)
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
# For Gmail, use App Password: https://support.google.com/accounts/answer/185833
SMTP_PASSWORD=your-app-password-here
FROM_EMAIL=noreply@jusor-translation.com
CONTACT_EMAIL=info@jusortrans.com

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,rtf
UPLOAD_PATH=/uploads

# ==============================================
# ANALYTICS & TRACKING
# ==============================================
# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads Conversion Tracking
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-11329570367

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-TQ66TPPT

# Facebook Pixel
NEXT_PUBLIC_FB_PIXEL_ID=123456789012345

# LinkedIn Partner ID
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=12345

# Hotjar Site ID
HOTJAR_ID=123456

# FullStory Organization ID
FULLSTORY_ORG_ID=your-org-id

# ==============================================
# CACHE CONFIGURATION (REDIS - OPTIONAL)
# ==============================================
REDIS_URL=redis://localhost:6379
# For Redis with authentication:
# REDIS_URL=redis://username:password@hostname:port

CACHE_TTL=300

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# ==============================================
# DEVELOPMENT & DEBUGGING
# ==============================================
# Set to true for development, false for production
NEXT_PUBLIC_DEBUG=false
NODE_ENV=development

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# ==============================================
# DOCKER & DEPLOYMENT (PRODUCTION ONLY)
# ==============================================
# Used by Docker Compose for production deployment
SITE_URL=https://jusor-translation.com
REDIS_PASSWORD=secure_redis_password_here

# ==============================================
# THIRD-PARTY INTEGRATIONS (OPTIONAL)
# ==============================================
# Stripe for payments (if implementing payment features)
# STRIPE_PUBLIC_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid for transactional emails (alternative to SMTP)
# SENDGRID_API_KEY=SG.xxx
# SENDGRID_FROM_EMAIL=noreply@jusor-translation.com

# Cloudinary for image management (if implementing file uploads)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your-api-secret

# ==============================================
# ENVIRONMENT-SPECIFIC NOTES
# ==============================================

# DEVELOPMENT (.env.local):
# - Use localhost for database and Redis
# - Disable analytics or use test IDs
# - Enable debugging
# - Use test SMTP credentials

# PRODUCTION (.env.production):
# - Use production database with connection pooling
# - Enable all analytics with real tracking IDs
# - Disable debugging
# - Use production SMTP with proper authentication
# - Enable HTTPS and security headers

# STAGING (.env.staging):
# - Use staging database
# - Use test analytics IDs
# - Enable debugging for troubleshooting
# - Use staging domain

# ==============================================
# SECURITY CHECKLIST
# ==============================================
# ✅ No hardcoded secrets in code
# ✅ Strong passwords (minimum 12 characters)
# ✅ Unique NEXTAUTH_SECRET (minimum 32 characters)
# ✅ App passwords for email providers
# ✅ Restricted database user permissions
# ✅ HTTPS enabled in production
# ✅ Environment files not committed to git
# ✅ Regular secret rotation schedule

# ==============================================
# TROUBLESHOOTING
# ==============================================
# Database connection issues:
# 1. Verify PostgreSQL is running
# 2. Check database name, user, and password
# 3. Ensure user has necessary permissions
# 4. Test connection with: psql -h localhost -U postgres -d jusor_nextjs

# Email not sending:
# 1. Use App Passwords for Gmail (not regular password)
# 2. Enable "Less secure app access" if using regular SMTP
# 3. Check SMTP host and port settings
# 4. Verify firewall allows SMTP traffic

# Analytics not tracking:
# 1. Verify tracking IDs are correct
# 2. Check if ad blockers are interfering
# 3. Ensure NEXT_PUBLIC_ prefix for client-side variables
# 4. Test in production environment (some analytics don't work on localhost)

# ==============================================
# QUICK SETUP COMMANDS
# ==============================================
# 1. Copy this file:
#    cp .env.example .env.local

# 2. Generate NEXTAUTH_SECRET:
#    openssl rand -base64 32

# 3. Test database connection:
#    psql -h localhost -U postgres -d jusor_nextjs

# 4. Start development server:
#    npm run dev
