# ==============================================
# JUSOR Translation Services - Test Environment Configuration
# Complete environment variables for test/development setup
# ==============================================

# ==============================================
# CORE APPLICATION CONFIGURATION
# ==============================================

# Node.js Environment
NODE_ENV=test

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1

# Site Base Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEBUG=true

# ==============================================
# COMPANY & BRANDING CONFIGURATION
# ==============================================

# Company Information
NEXT_PUBLIC_COMPANY_NAME=JUSOR Translation Services
NEXT_PUBLIC_COMPANY_DESCRIPTION=Professional translation services for legal, technical, and business documents
NEXT_PUBLIC_COMPANY_PHONE=+971503244329
NEXT_PUBLIC_COMPANY_EMAIL=info@jusortrans.com
NEXT_PUBLIC_COMPANY_ADDRESS=Dubai, UAE

# Content Security Policy
NEXT_PUBLIC_CSP_NONCE=test-csp-nonce-12345

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# PostgreSQL Connection (Primary)
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/jusor_test_db

# Alternative PostgreSQL Variables (Supabase/Vercel style)
POSTGRES_URL=postgresql://test_user:test_password@localhost:5432/jusor_test_db
POSTGRES_URL_NON_POOLING=postgresql://test_user:test_password@localhost:5432/jusor_test_db
POSTGRES_PRISMA_URL=postgresql://test_user:test_password@localhost:5432/jusor_test_db

# Individual Database Variables (fallback)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jusor_test_db
DB_USER=test_user
DB_USERNAME=test_user
DB_PASSWORD=test_password

# Supabase/Cloud Database Variables
POSTGRES_HOST=localhost
POSTGRES_DATABASE=jusor_test_db
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password

# ==============================================
# AUTHENTICATION & SECURITY
# ==============================================

# NextAuth Configuration
NEXTAUTH_SECRET=test-super-secret-key-minimum-32-characters-for-testing-purposes
NEXTAUTH_URL=http://localhost:3000

# Admin User Creation (for scripts)
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=test123456
ADMIN_NAME=Test Admin User

# ==============================================
# EMAIL CONFIGURATION
# ==============================================

# SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test_smtp_user
SMTP_PASSWORD=test_smtp_password

# Email Addresses
FROM_EMAIL=noreply@test.jusor-translation.com
CONTACT_EMAIL=test@jusor-translation.com

# Alternative Email Service (SendGrid)
SENDGRID_API_KEY=SG.test_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@test.jusor-translation.com

# ==============================================
# FILE UPLOAD & STORAGE CONFIGURATION
# ==============================================

# Local File Upload Settings
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,rtf,jpg,jpeg,png,gif,webp
UPLOAD_PATH=/uploads

# Cloudinary Configuration (optional)
CLOUDINARY_CLOUD_NAME=test-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=test-api-secret-key

# ==============================================
# CACHE & PERFORMANCE CONFIGURATION
# ==============================================

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=test_redis_password

# Cache Settings
CACHE_TTL=300

# ==============================================
# RATE LIMITING CONFIGURATION
# ==============================================

# Rate Limiting Settings
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# ==============================================
# ANALYTICS & TRACKING (TEST/DISABLED)
# ==============================================

# Google Analytics 4 (test property)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-TEST123456

# Google Tag Manager (production container - use test container in actual test env)
NEXT_PUBLIC_GTM_ID=GTM-TQ66TPPT

# Facebook Pixel (test pixel)
NEXT_PUBLIC_FB_PIXEL_ID=123456789012345

# LinkedIn Partner ID (test)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=12345

# Hotjar Site ID (test)
HOTJAR_ID=123456

# FullStory Organization ID (test)
FULLSTORY_ORG_ID=test-org-id

# ==============================================
# THIRD-PARTY INTEGRATIONS
# ==============================================

# Google Maps API (for contact page map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=test_google_maps_api_key

# Payment Processing (Stripe - test keys)
STRIPE_PUBLIC_KEY=pk_test_test_stripe_public_key
STRIPE_SECRET_KEY=sk_test_test_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret

# ==============================================
# SEO & VERIFICATION (TEST)
# ==============================================

# Search Engine Verification (test values)
GOOGLE_SITE_VERIFICATION=test_google_verification_code
YANDEX_VERIFICATION=test_yandex_verification_code
YAHOO_VERIFICATION=test_yahoo_verification_code

# ==============================================
# MONITORING & LOGGING (TEST)
# ==============================================

# Error Tracking (Sentry - test DSN)
SENTRY_DSN=https://test@sentry.io/test-project-id

# Application Performance Monitoring
APM_SERVICE_NAME=jusor-test
APM_ENVIRONMENT=test

# ==============================================
# DOCKER & DEPLOYMENT (TEST)
# ==============================================

# Docker Compose Variables
SITE_URL=http://localhost:3000
COMPOSE_PROJECT_NAME=jusor-test

# ==============================================
# FEATURE FLAGS & TOGGLES
# ==============================================

# Feature Toggles for Testing
FEATURE_BLOG_ENABLED=true
FEATURE_PROJECTS_ENABLED=true
FEATURE_ANALYTICS_ENABLED=false
FEATURE_CACHE_ENABLED=true
FEATURE_EMAIL_ENABLED=true

# ==============================================
# TEST-SPECIFIC OVERRIDES
# ==============================================

# Test Database (separate from development)
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/jusor_test_db

# Mock Services for Testing
MOCK_EMAIL_SERVICE=true
MOCK_ANALYTICS=true
MOCK_PAYMENT_GATEWAY=true

# Test File Storage
TEST_UPLOAD_PATH=/tmp/test-uploads
TEST_MAX_FILE_SIZE=5242880

# ==============================================
# BACKUP & RECOVERY (TEST)
# ==============================================

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7

# ==============================================
# INTERNATIONALIZATION (I18N)
# ==============================================

# Default Language Settings
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar
FALLBACK_LOCALE=en

# ==============================================
# SECURITY HEADERS & CSP
# ==============================================

# Content Security Policy
CSP_REPORT_URI=/api/csp-report
CSP_REPORT_ONLY=true

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000

# ==============================================
# API CONFIGURATION
# ==============================================

# API Rate Limiting
API_RATE_LIMIT=1000
API_RATE_WINDOW=3600

# API Versioning
API_VERSION=v1
API_PREFIX=/api

# ==============================================
# DEVELOPMENT & DEBUGGING
# ==============================================

# Debug Settings
DEBUG_SQL_QUERIES=true
DEBUG_CACHE_OPERATIONS=true
DEBUG_EMAIL_SENDING=true

# Development Tools
WEBPACK_BUNDLE_ANALYZER=false
REACT_STRICT_MODE=true

# ==============================================
# HEALTH CHECKS & MONITORING
# ==============================================

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT=5000

# Uptime Monitoring
UPTIME_ROBOT_API_KEY=test_uptime_robot_key

# ==============================================
# NOTES FOR TEST ENVIRONMENT
# ==============================================

# This configuration is specifically designed for testing environments
# - All analytics are disabled or use test IDs
# - Email uses test SMTP (Mailtrap recommended)
# - Database uses separate test database
# - File uploads go to test directory
# - All secrets use test/placeholder values
# - Debug mode is enabled for troubleshooting
# - Rate limits are relaxed for testing
# - Mock services are enabled where appropriate

# ==============================================
# SECURITY REMINDERS
# ==============================================

# ✅ This file contains test values only
# ✅ No production secrets are included
# ✅ All test databases are isolated
# ✅ Mock services prevent external API calls
# ✅ Debug logging is enabled for troubleshooting
# ✅ Rate limiting is configured for test scenarios

# ==============================================
# QUICK TEST SETUP
# ==============================================

# 1. Copy this file to your test environment:
#    cp .env.test .env.local

# 2. Start test database:
#    docker run --name postgres-test -e POSTGRES_DB=jusor_test_db -e POSTGRES_USER=test_user -e POSTGRES_PASSWORD=test_password -p 5432:5432 -d postgres:15

# 3. Initialize test database:
#    npm run db:init

# 4. Create test admin user:
#    npm run admin:create-user

# 5. Start development server:
#    npm run dev

# 6. Run tests:
#    npm test